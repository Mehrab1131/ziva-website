---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChannelCard from "../components/ChannelCard.astro";
import { site } from "../data/site";
import { formatDate, getSortedArticles } from "../lib/utils";

const articles = await getSortedArticles(5);
const announcements = site.channels.find((channel) => channel.id === "announcements");

const telegramCards = [
  { title: announcements?.title ?? "", description: announcements?.description, url: announcements?.url },
  { title: "کانال‌های آموزشی", description: "کانال‌های تخصصی متوسطه اول و دوم", url: "/channels/" },
  { title: "ارتباط با ما در تلگرام", description: "پرسش‌ها، پیشنهادها و گفت‌وگو با ما در تلگرام." },
];

const focusCards = [
  {
    className: "focus-card-green",
    title: "زیست‌شناسی دبیرستان",
    description: "تدریس مفهومی زیست‌شناسی، آمادگی امتحانات نهایی و مسیر آمادگی کنکور.",
    href: "/education/#biology",
    art: "/images/banner-biology.svg",
    alt: "تصویر زیستی برای زیست‌شناسی دبیرستان",
    icon: ["M5 5.5A2.5 2.5 0 0 1 7.5 3H20v16H7.5A2.5 2.5 0 0 0 5 21V5.5Z", "M5 5.5V21M8 7h8M8 11h8"],
  },
  {
    className: "focus-card-blue",
    title: "علوم متوسطه اول",
    description: "علوم هفتم، هشتم و نهم با تأکید بر فهم مفاهیم، فعالیت‌ها و ارتباط با دنیای واقعی.",
    href: "/education/#science",
    art: "/images/banner-science.svg",
    alt: "تصویر علمی برای علوم متوسطه اول",
    icon: ["M9 3h6M10 3v7l-5.5 8.8A1.5 1.5 0 0 0 5.8 21h12.4a1.5 1.5 0 0 0 1.3-2.2L14 10V3", "M7.8 16h8.4"],
  },
  {
    className: "focus-card-mint",
    title: "پروژه‌ها و مطالعات عمیق",
    description: "پروژه‌هایی مانند دورهٔ زیست‌شناسی بر پایهٔ Campbell Biology و ایده‌های آموزشی آینده.",
    href: "/courses/#campbell",
    art: "/images/banner-research.svg",
    alt: "تصویر پژوهشی برای پروژه‌ها و مطالعات عمیق",
    icon: ["M12 20V8M12 8C8 8 6 6 6 3c4 0 6 2 6 5ZM12 13c4 0 6-2 6-5-4 0-6 2-6 5Z", "M7 20h10"],
  },
];
---
<BaseLayout title="زیوا | آموزش برای فهمیدن، نه فقط به خاطر سپردن." preloadImage="/images/hero-cell.webp">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-art">
        <div class="art-glow" aria-hidden="true"></div>
        <img
          class="hero-photo"
          src="/images/hero-cell.webp"
          alt="تصویر سه‌بعدی یک سلول زنده با هسته و میتوکندری، در کنار رشتهٔ DNA"
          width="960"
          height="738"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-copy">
        <div class="hero-kicker"><span></span> کاوش · یادگیری · رشد</div>
        <h1>زیست‌شناسی،<br />برای فردایی روشن‌تر.</h1>
        <p class="hero-lead">
          زیوا یک مجموعهٔ آموزشی با تمرکز بر آموزش عمیق و مفهومی زیست‌شناسی و علوم تجربی است. هدف ما، ایجاد درکی واقعی از پدیده‌های زنده و پرورش تفکر علمی در یادگیری است.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/education/">مشاهده موضوعات آموزشی <span aria-hidden="true">←</span></a>
          <a class="button button-secondary" href="/about/">درباره زیوا <span aria-hidden="true">←</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section focus-section">
    <div class="container">
      <div class="section-heading section-heading-row">
        <div>
          <span class="section-kicker">یادگیری در زیوا</span>
          <h2>محورهای آموزشی</h2>
        </div>
        <a class="section-more" href="/education/">مشاهده همه <span aria-hidden="true">←</span></a>
      </div>

      <div class="focus-grid">
        {focusCards.map((card) => (
          <article class:list={["focus-card", card.className]}>
            <div class="focus-banner"><img src={card.art} alt={card.alt} width="800" height="220" loading="lazy" decoding="async" /></div>
            <div class="focus-card-body">
              <span class="focus-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">{card.icon.map((d) => <path d={d} />)}</svg>
              </span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <a class="card-arrow" href={card.href} aria-label={card.title}><span aria-hidden="true">←</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section content-section">
    <div class="container content-split">
      <section class="telegram-panel" id="telegram">
        <div class="section-heading section-heading-row">
          <div>
            <span class="section-kicker">همراه زیوا باشید</span>
            <h2>کانال‌های زیوا در تلگرام</h2>
          </div>
        </div>
        <div class="telegram-cards">
          {telegramCards.map((card) => <ChannelCard {...card} />)}
        </div>
      </section>

      <section class="articles-panel">
        <div class="section-heading section-heading-row">
          <div>
            <span class="section-kicker">تازه‌های زیوا</span>
            <h2>آخرین مطالب آموزشی</h2>
          </div>
          <a class="section-more" href="/articles/">مشاهده همه <span aria-hidden="true">←</span></a>
        </div>
        <div class="article-list">
          {articles.map((article) => (
            <article class="article-row">
              <a class="article-thumb" href={`/articles/${article.id}/`} aria-label={`تصویر ${article.data.title}`}>
                <img src={article.data.image ?? "/images/article-placeholder.svg"} alt="" width="82" height="66" loading="lazy" decoding="async" />
              </a>
              <div class="article-row-copy">
                <span class="article-category">{article.data.category}</span>
                <h3><a href={`/articles/${article.id}/`}>{article.data.title}</a></h3>
                <div class="article-meta">
                  <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
                  <span>مطالعه <span aria-hidden="true">←</span></span>
                </div>
              </div>
              <a class="article-row-arrow" href={`/articles/${article.id}/`} aria-label={`مطالعه ${article.data.title}`}><span aria-hidden="true">←</span></a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
