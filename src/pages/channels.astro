---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const channels = site.telegram.channels;
const descriptionFor = (title: string) => {
  if (title === "اطلاع‌رسانی و برنامه‌ها") return "آخرین اطلاعیه‌ها و برنامه‌های آموزشی زیوا.";
  if (title === "زیست‌شناسی دبیرستان") return "مطالب تخصصی زیست‌شناسی دبیرستان و مسیرهای آموزشی زیوا.";
  return `کانال تخصصی ${title} برای آموزش علوم و پیگیری مطالب زیوا.`;
};
---
<BaseLayout title="کانال‌های زیوا در تلگرام | زیوا" description="فهرست کانال‌های تلگرام زیوا برای زیست‌شناسی و علوم تجربی.">
  <section class="page-hero">
    <div class="narrow">
      <span class="eyebrow">زیوا · تلگرام</span>
      <h1>کانال‌های زیوا در تلگرام</h1>
      <p>کانال‌های تخصصی زیوا را برای اطلاع‌رسانی، آموزش زیست‌شناسی و علوم تجربی و ارتباط با ما دنبال کنید.</p>
    </div>
  </section>

  <section class="section">
    <div class="container channels-grid">
      {channels.map((channel) => (
        <article class="channel-page-card">
          <div class="channel-page-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M21.6 3.4 18.4 20c-.2 1.2-.9 1.5-1.8.9l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.2-8.3c.4-.4-.1-.6-.6-.2L5.9 13.5.9 12c-1.1-.3-1.1-1 .2-1.5L20.7 3c.9-.3 1.3.2.9.4Z"/></svg>
          </div>
          <h2>{channel.title}</h2>
          <p>{descriptionFor(channel.title)}</p>
          {channel.url ? (
            <a class="button button-primary" href={channel.url} target="_blank" rel="noopener noreferrer">ورود به کانال <span aria-hidden="true">←</span></a>
          ) : (
            <span class="channel-link-muted">لینک کانال به‌زودی اضافه می‌شود</span>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
