---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="صفحه پیدا نشد | زیوا" description="صفحهٔ مورد نظر پیدا نشد." noindex>
  <section class="section">
    <div class="container empty-state">
      <div class="empty-mark">◌</div>
      <h1>صفحه‌ای که دنبالش بودید پیدا نشد</h1>
      <p>ممکن است نشانی را اشتباه وارد کرده باشید یا این صفحه جابه‌جا شده باشد.</p>
      <a class="button button-primary" href="/">بازگشت به صفحه اصلی</a>
    </div>
  </section>
</BaseLayout>
